# Copy to .env and fill in. Never commit .env. Values below are placeholders.

# Public URL of this deployment, used for transcript links in Telegram and HubSpot
APP_URL=https://aangan-studio-two.vercel.app

# Shared secret Vaani sends on every tool/webhook call (header x-aangan-secret or Bearer)
VAANI_TOOL_SECRET=generate-a-long-random-string

# Gemini API key from Google AI Studio (the 5-criteria check)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional override, defaults to gemini-3.8-flash
QUALIFY_MODEL=

# Neon Postgres (injected automatically by the Vercel Marketplace integration)
DATABASE_URL=

# Cal.com: consultation event type, and the studio inbox used for attendee emails
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_ATTENDEE_EMAIL=bookings@your-studio-domain.example

# HubSpot private app token (scopes: crm.objects.contacts, deals, calls/engagements, tasks write+read, crm.schemas.contacts.write)
HUBSPOT_TOKEN=
HUBSPOT_PIPELINE_ID=default
HUBSPOT_DEAL_STAGE_ID=
# Owner who gets complaint tasks (Nikhil)
HUBSPOT_OWNER_ID=

# Telegram bot + designers' group chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard (phase 2)
DASHBOARD_PASSWORD=
SESSION_SECRET=
